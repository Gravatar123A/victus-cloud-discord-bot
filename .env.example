# Victus Cloud Discord Bot — environment template.
# Copy to .env and fill in the secrets. .env is gitignored — NEVER commit real keys.

# ── Discord (required) ──────────────────────────────────────────────
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id
# DISCORD_GUILD_ID=            # optional: register commands to one guild during dev

# ── Supabase (required) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── AI reply provider (the AI that answers on ping / DM / /ask) ─────
# Defaults (in src/config.ts) already point at the Victus Azure AI Foundry
# GPT-5.6-sol deployment via the Responses API. To use it, you ONLY need to set
# the API key below. The Responses API is auto-detected from the /responses
# cognitiveservices URL. Legacy GROQ_* names are still accepted.
AI_API_KEY=your-azure-ai-foundry-key
AI_BASE_URL=https://ryf-foundry-test.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
AI_MODEL=gpt-5.6-sol
# Comma- or newline-separated keys are supported for rotation. If the primary
# provider fails, the bot tries AI_FALLBACK_API_KEYS before returning an error.
# For OpenRouter fallback/free models, set the fallback keys and leave the
# primary Azure settings above unchanged.
# AI_API_KEYS=key-one,key-two
# AI_FALLBACK_API_KEYS=openrouter-key-one,openrouter-key-two
# AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# AI_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
# AI_TEMPERATURE=0.35
# AI_MAX_TOKENS=4000          # gpt-5.6-sol reasons; keep this generous
# AI_WEB_SEARCH=true          # DuckDuckGo web tools (chat-completions providers only)
# VICTUS_AI_SYSTEM_PROMPT=    # extra operator instructions appended to the system prompt

# ── Lavalink (music) ────────────────────────────────────────────────
# LAVALINK_HOST=135.125.222.36
# LAVALINK_PORT=25578
# Required for music. Set this to the current DE-1 Lavalink server password.
LAVALINK_PASSWORD=your-lavalink-password
# LAVALINK_SECURE=false
# LAVALINK_SEARCH=ytsearch

# ── Optional integrations ───────────────────────────────────────────
# PTERODACTYL_URL=
# PTERODACTYL_API_KEY=
# PAYMENTER_URL=https://billing.victuscloud.com
# PAYMENTER_API_KEY=
# Required for Discord rewards, invite escrow, level rewards, and the economy
# reconciliation worker. This must match the Victus panel's internal token.
# PAYMENTER_INTERNAL_API_TOKEN=

# ── Bot behaviour (optional) ────────────────────────────────────────
# LOG_LEVEL=info
# DISCORD_LINKED_ROLE_ID=
# DISCORD_SUPPORT_GUILD_ID=
# DISCORD_AI_CHANNEL_ID=
# DISCORD_LEVEL_UP_CHANNEL_ID=1416377943776559204
# DISCORD_AUTO_REGISTER_COMMANDS=true

# UPTIME_KUMA_PUSH_URL=

# ── Shared community XP / level rewards (optional defaults) ─────────
# ECON_XP_PER_MESSAGE=10
# ECON_XP_PER_VOICE_MINUTE=15
# ECON_XP_PER_LEVEL=200
# ECON_COINS_PER_LEVEL=30
# ECON_MESSAGE_XP_COOLDOWN_SEC=0

# ── Antigravity Staff Work Pipeline ─────────────────────────────────
# ANTIGRAVITY_ENABLED=true
# DISCORD_STAFF_AI_CHANNEL_ID=your-staff-ai-channel-id
# DISCORD_STAFF_ROLE_IDS=staff-role-id-1,staff-role-id-2
# ANTIGRAVITY_WORKDIR=e:/heheboi - projects
# ANTIGRAVITY_MODEL=gemini-3.8-flash-high
# ANTIGRAVITY_TIMEOUT_MS=300000
